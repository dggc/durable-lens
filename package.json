{
  "name": "durable-lens",
  "version": "0.1.0",
  "description": "Local, read-only inspector for pi-durable storage: transcript, task graph, documents, cost and time on one timeline.",
  "license": "MIT",
  "author": "Daniel Galinkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dggc/durable-lens.git"
  },
  "homepage": "https://dggc.github.io/durable-lens/",
  "bugs": {
    "url": "https://github.com/dggc/durable-lens/issues"
  },
  "type": "module",
  "bin": {
    "durable-lens": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "pi",
    "pi-durable",
    "agents",
    "inspector",
    "devtools",
    "sqlite",
    "jsonl"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p src/web/tsconfig.json && node scripts/copy-web.mjs",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.ts",
    "coverage": "npm run build && node scripts/coverage.mjs",
    "check:ui": "npm run build && node scripts/check-ui.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm run coverage && npm run check:package",
    "fixtures": "node fixtures/generate/build.mjs",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  }
}
